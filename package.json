{
  "name": "butler-ai",
  "version": "0.1.0",
  "private": true,
  "description": "管家式 AI —— 可审计的记忆治理与自进化系统",
  "type": "module",
  "bin": {
    "butler": "bin/butler.mjs"
  },
  "scripts": {
    "butler": "node bin/butler.mjs",
    "dev": "next dev",
    "dev:vite": "vite",
    "build": "next build",
    "preview": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:1": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/01-orchestration.ts",
    "validate:2": "node node_modules/tsx/dist/cli.mjs src/validate/02-memory-loop.ts",
    "validate:3": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/03-tool-use.ts",
    "validate:4": "node node_modules/tsx/dist/cli.mjs src/validate/04-activity-profile.ts",
    "validate:5": "node node_modules/tsx/dist/cli.mjs src/validate/05-mcp.ts",
    "validate:6": "node node_modules/tsx/dist/cli.mjs src/validate/06-persistence.ts",
    "validate:7": "node node_modules/tsx/dist/cli.mjs src/validate/07-runtime-restart.ts"
  },
  "dependencies": {
    "next": "15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.0"
}
