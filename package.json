{
  "name": "butler-ai",
  "version": "0.1.0",
  "private": true,
  "description": "butler —— 可审计的记忆治理与自进化系统",
  "type": "module",
  "bin": {
    "butler": "bin/butler.mjs"
  },
  "scripts": {
    "butler": "node bin/butler.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "preview": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:a11y": "node scripts/a11y-contrast.mjs",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:1": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/01-orchestration.ts",
    "validate:2": "node node_modules/tsx/dist/cli.mjs src/validate/02-memory-loop.ts",
    "validate:3": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/03-tool-use.ts",
    "validate:4": "node node_modules/tsx/dist/cli.mjs src/validate/04-activity-profile.ts",
    "validate:5": "node node_modules/tsx/dist/cli.mjs src/validate/05-mcp.ts",
    "validate:6": "node node_modules/tsx/dist/cli.mjs src/validate/06-persistence.ts",
    "validate:7": "node node_modules/tsx/dist/cli.mjs src/validate/07-runtime-restart.ts",
    "validate:8": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/08-real-path.ts",
    "validate:9": "node node_modules/tsx/dist/cli.mjs src/validate/09-context-compaction.ts",
    "validate:10": "node node_modules/tsx/dist/cli.mjs src/validate/10-low-confidence.ts",
    "validate:11": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/11-contract.ts",
    "validate:12": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/12-butler-execute.ts",
    "validate:13": "node node_modules/tsx/dist/cli.mjs src/validate/13-quiz-grade.ts",
    "validate:14": "node node_modules/tsx/dist/cli.mjs src/validate/14-transfer.ts",
    "validate:15": "node node_modules/tsx/dist/cli.mjs src/validate/15-desktop.ts",
    "validate:16": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/16-vision.ts",
    "validate:17": "node node_modules/tsx/dist/cli.mjs src/validate/17-attachment.ts",
    "validate:18": "node node_modules/tsx/dist/cli.mjs src/validate/18-mcp-wiring.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "next": "15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.0"
}
