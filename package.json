{
  "name": "butler-ai",
  "version": "0.1.0",
  "private": true,
  "description": "butler —— 可审计的记忆治理与自进化系统",
  "type": "module",
  "bin": {
    "butler": "bin/butler.mjs"
  },
  "scripts": {
    "butler": "node bin/butler.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "preview": "next start -H 127.0.0.1",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:a11y": "node scripts/a11y-contrast.mjs",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:http": "node scripts/verify-http-e2e.mjs",
    "verify:ui": "node scripts/verify-ui-e2e.mjs",
    "bench:events": "node --import tsx scripts/bench-eventlog.ts",
    "eval:extraction": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-extraction.ts",
    "eval:documents": "node --import tsx scripts/eval-documents.ts",
    "eval:knowledge": "node --import tsx scripts/eval-knowledge-retrieval.ts",
    "eval:documents:qa": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-documents-qa.ts",
    "eval:recall": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-recall.ts",
    "eval:recall:dev": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-recall.ts --split=dev",
    "eval:recall:test": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-recall.ts --split=test",
    "eval:recall:all": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-recall.ts --split=all",
    "eval:memory": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-recall.ts --split=dev --mode=literal",
    "eval:memory:semantic": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/eval-recall.ts --split=dev --mode=semantic",
    "eval:autonomous": "node --import tsx scripts/eval-autonomous-memory.ts",
    "eval:diary:real": "node --import tsx scripts/eval-diary-real.ts",
    "eval:memory:ab": "node --import tsx scripts/eval-memory-ab.ts",
    "validate:diary:pipeline": "node --import tsx scripts/validate-diary-pipeline.ts",
    "validate:rerank:local": "node --import tsx scripts/validate-local-rerank.ts",
    "validate:rerank:cross": "node --import tsx scripts/validate-cross-rerank.ts",
    "eval:extraction:effect": "node --import tsx scripts/eval-extraction-effect.ts",
    "validate:1": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/01-orchestration.ts",
    "validate:2": "node node_modules/tsx/dist/cli.mjs src/validate/02-memory-loop.ts",
    "validate:3": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/03-tool-use.ts",
    "validate:4": "node node_modules/tsx/dist/cli.mjs src/validate/04-activity-profile.ts",
    "validate:5": "node node_modules/tsx/dist/cli.mjs src/validate/05-mcp.ts",
    "validate:6": "node node_modules/tsx/dist/cli.mjs src/validate/06-persistence.ts",
    "validate:7": "node node_modules/tsx/dist/cli.mjs src/validate/07-runtime-restart.ts",
    "validate:8": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/08-real-path.ts",
    "validate:9": "node node_modules/tsx/dist/cli.mjs src/validate/09-context-compaction.ts",
    "validate:10": "node node_modules/tsx/dist/cli.mjs src/validate/10-low-confidence.ts",
    "validate:11": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/11-contract.ts",
    "validate:12": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/12-butler-execute.ts",
    "validate:13": "node node_modules/tsx/dist/cli.mjs src/validate/13-quiz-grade.ts",
    "validate:14": "node node_modules/tsx/dist/cli.mjs src/validate/14-transfer.ts",
    "validate:15": "node node_modules/tsx/dist/cli.mjs src/validate/15-desktop.ts",
    "validate:16": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/validate/16-vision.ts",
    "validate:17": "node node_modules/tsx/dist/cli.mjs src/validate/17-attachment.ts",
    "validate:18": "node node_modules/tsx/dist/cli.mjs src/validate/18-mcp-wiring.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "next": "15",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.0"
}
