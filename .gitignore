# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tsbuildinfo

# 环境变量（⚠️ 绝不提交任何真实密钥）
.env
.env.local
.env.*.local

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
npm-debug.log*
pnpm-debug.log*
coverage/

# 本地数据（本地优先架构，用户数据不入库）
.data/
*.sqlite
*.sqlite-journal

# ── Next.js ──
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ── 运行时数据（本机记忆与事件流，绝不入库）──
/.butler-data/
*.jsonl

# MCP 配置可能含 env 密钥；默认不入库（模板见 .env.example）
/mcp.json
# 桌宠验收截图与 Python 缓存（不入库）
__pycache__/
# 截图 / 评审图片一律不入库（会显著撑大仓库，且属于过程证据而非交付物）
# ⚠️ 应用运行时必需的静态资源在 public/ 下，单独放行
*.png
*.jpg
*.jpeg
*.webp
!public/**/*.png
# Next.js 文件约定图标必须进版本库
!src/app/icon.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.webp

# 单独验证 production build 的临时产物
.next-verify/
