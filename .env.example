# ═══════════════════════════════════════════════════════════════
# 环境变量模板
# ═══════════════════════════════════════════════════════════════
#
# 使用方法：
#   cp .env.example .env.local
#   然后填入真实值。.env.local 已在 .gitignore 中，不会被提交。
#
# ⚠️ 规则红线：API 密钥等敏感信息不得出现在公开仓库中。
#
# ───────────────────────────────────────────────────────────────
# ★ 本模板的每一行都与代码对应
#
#   之前的模板声明了 17 个变量，而代码只读了 2 个 —— 其余改了
#   **没有任何作用**。一个「看起来完整但不起作用」的模板比没有
#   模板更糟：使用者改了发现无效，会直接质疑配置说明是否真实。
#
#   现在：改任何一个变量都会真的生效。而且**全部默认值与原硬编码值
#   一致** —— 不填就与改动前完全相同。
#
#   读取集中在 `src/core/config/env.ts`（单一来源，避免模板与代码漂移）。
#   自检：`butler doctor` 显示每个变量的实际生效值与解析问题。
#
# ───────────────────────────────────────────────────────────────
# ★ 写错不会导致启动失败
#
#   数字写错、布尔值写错 → **退回默认值**，并把问题记下来由
#   `butler doctor` 展示。
#   （静默吞掉错误和直接崩掉都是坏选择：前者让人以为配上了，
#     后者因为一个数字写错就让整个服务起不来。）
# ═══════════════════════════════════════════════════════════════


# ─────────────── 模型服务 ───────────────

# 主模型厂商：deepseek | openai | ollama
#
# 留空时按 `<BUTLER_DATA_DIR>/model-settings.json`（设置页切换后写入）读取；
# 再没有就用 deepseek。填了本变量后，设置页**不允许切换**（显式锁定）。
MODEL_PROVIDER=

# OpenAI 兼容端点（非流式主模型；叙述流仅 DeepSeek 支持）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama 本地端点（OpenAI 兼容）
# 默认模型可按本机实际安装改；验证不过时不会允许切换。
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# 主力模型：推理、意图路由、记忆提取与反思。
# ★ 唯一必需项 —— 不填则对话不可用（记忆治理相关功能仍可用）。
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 接口地址。一般不需要改（换兼容 OpenAI 协议的代理时才改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 结构化调用用的模型（路由 / 分解 / 仆人执行 / 监督 / 反思）。
#
# ★ 官方（Models & Pricing 文档）只有两个模型：
#     deepseek-flash    ← 默认。便宜约 4—5 倍，**支持读图**，支持思考
#     deepseek-v4-pro     更贵，**不支持读图**，支持思考
#
# ⚠️ 不要填 deepseek-chat —— 该模型**已不在官方清单里**，填了可能直接不可用。
# 不填则用 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash

# ★ 叙述（流式"边说边想"）用的模型。
#
# ⚠️ 为什么单独一个变量：**必须选有思考分片的模型**。
#    实测（三个模型逐一验证）：
#      deepseek-chat       完全不产 reasoning_content（推理流会是空的，且不报错）
#      deepseek-flash      产思考 + 正文，最快（1.6—2.4 秒）  ← 默认值
#      deepseek-v4-pro     产思考 + 正文，但慢（约 11.8 秒）
#
#    填错不会报错，只会让「推理流」永远是空的 —— 所以特意留了这个变量
#    并写清结论，换模型后不用重新踩一遍。
NARRATION_MODEL=deepseek-flash

# 单次模型调用超时（毫秒）
MODEL_TIMEOUT_MS=90000


# ─────────────── 编排 ───────────────

# 路由置信度阈值：低于此值不猜测，转为询问用户（见方案 § 2.2①）
# 取值范围 0—1
ROUTING_CONFIDENCE_THRESHOLD=0.6


# ─────────────── 记忆演化（见方案 § 8.4）───────────────

# 适应度 EMA 平滑系数 α，取值范围 0.001—1。
# 越小越「渐变」，越不容易被单次事件影响。
# ★ 这是记忆演化的核心参数：它决定 AI 多快改变对你的判断。
FITNESS_EMA_ALPHA=0.15

# 连续未命中多少天后进入休眠（休眠不是删除，重新命中会复活）
MEMORY_DORMANT_DAYS=60

# 适应度低于此值且长期休眠则归档，取值范围 0—1
MEMORY_ARCHIVE_FITNESS_THRESHOLD=0.25

# 探索性召回比例，取值范围 0—1（防局部最优，见方案 § 8.5）
# ⚠️ 设为 0 会让系统只推荐「已知好用」的记忆，可能陷入局部最优
EXPLORATORY_RECALL_RATIO=0.1

# 语义召回补充候选的最低余弦阈值，取值范围 0—1
# 2026-10-25 30 条评测：0.40 命中 27/30，0.35 命中 29/30，负例误召回都 1/5；0.30 噪声过多
MEMORY_SEMANTIC_THRESHOLD=0.35
# 语义 top-k 补充通道：只补充少量低于阈值的候选，再由精排过滤。
# 0 关闭；默认 5（dev 结果：topK=3 仍漏“火锅→减脂”，5 才能补进来）。
MEMORY_SEMANTIC_TOPK=5
# top-k 补充的语义下限；低于它的候选不进入补充池。
MEMORY_SEMANTIC_FLOOR=0.3
# 精排过滤阈值；低于它的软记忆会被丢弃，硬约束始终保留。
MEMORY_RERANK_MIN_RELEVANCE=0.5

# 记忆冲突检测：off=关闭（默认）；review=只发现可能冲突并标记待审，不自动裁决
CONFLICT_DETECTION_MODE=off


# ─────────────── 成本与安全熔断 ───────────────

# 单条命令类工具的执行耗时上限（毫秒）
# ⚠️ 硬上限 5 分钟写在代码里，不由此变量放宽
TOOL_TIMEOUT_MS=15000

# 操作范围熔断：窗口内非只读工具调用超过上限就拒绝（不是成本额度）
TOOL_FUSE_WINDOW_MS=60000
TOOL_FUSE_MAX_WRITES=30

# 监督员触发：manual=只在用户按需发起（v10 目标）；auto=每轮自动复核（回退用）
SUPERVISOR_MODE=manual

# 定时任务每日耗 token 的次数上限（到上限后自动跳过，保留只读浏览）
DAILY_TOKEN_TASK_LIMIT=10

# 单个定时任务的超时（毫秒）；超时记失败，不再重试
SCHEDULE_TASK_TIMEOUT_MS=120000


# ─────────────── 隐私（见方案 § 7.3）───────────────

# 原始活动记录保留天数，到期自动清除，长期仅保留聚合规律。
# ⚠️ 采集边界（采什么、聚合后原文即删）写死在代码中，不由此变量放宽。
ACTIVITY_RAW_RETENTION_DAYS=7


# ─────────────── 本地存储 ───────────────

# 数据目录（事件流与记忆的落盘位置）。支持相对路径与绝对路径。
BUTLER_DATA_DIR=.butler-data

# 本地 embedding 模型目录；留空表示 <BUTLER_DATA_DIR>/models
# 先运行：pnpm exec tsx scripts/download-embedding-model.ts
BUTLER_MODEL_DIR=

# C5 三档权限：view / workspace / full；留空保持旧行为
BUTLER_PERMISSION_MODE=

# 用户标识。记忆按这个 id 归属，换 id 等于换一套记忆。
BUTLER_USER_ID=local


# ═══════════════════════════════════════════════════════════════
# ⚠️ 以下为「预留位」—— 当前代码尚未接入，填了不生效
#
#    留着它们是为了标明将来接这些能力时的位置。
#    写明「预留」比假装支持好 —— 后者会让人配了却不见效。
# ═══════════════════════════════════════════════════════════════

# ── 日额度（按金额，预留）──
#
# ⚠️ **当前额度机制按「次数」计，不按「金额」计** ——
#    真正生效的是上面的 `DAILY_TOKEN_TASK_LIMIT`。
#    按金额熔断需要先有 token 计价表，尚未实现。
#
#    留着这个位置是因为「预算」比「次数」更符合用户直觉，
#    将来接上计价后应改用它。
# DAILY_BUDGET_CNY=20

# ── 独立视觉模型（预留）──
#
# ⚠️ 当前多模态走的是**主模型自身的视觉能力**，不需要单独配置。
#    实测（见验证 3）：`deepseek-chat` 可读图，`deepseek-v4-pro` **不可**
#    —— 且后者是**静默失败**（HTTP 200，正文却说「无法查看图片」）。
#
# 将来若接入独立视觉模型，用这三个变量指定。
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=

# ── 行为观察默认开关（预留）──
#
# ⚠️ 默认关闭。方案 § 7.3 要求：观察必须由用户**明确授权**，
#    所以即使设为 true 也只是给个默认值，仍需用户显式授权。
#    采集边界写死在代码中，不由此变量放宽。
# BEHAVIOR_OBSERVATION_ENABLED=false

# ── 云端同步（预留）──
#
# ⚠️ 当前**恒为本地**：事件流与记忆只写本地 JSONL，
#    代码里没有任何「上传到远端」的路径。
#    这个开关是给将来引入云端同步时预留的位置。
# LOCAL_FIRST=true

# ── 数据导出包含凭证（预留）──
#
# ⚠️ 导出功能尚未实现。默认排除凭证；将来设为 true 时必须提供加密口令。
# EXPORT_INCLUDE_CREDENTIALS=false
