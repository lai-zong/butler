# 环境变量模板
#
# 使用方法：
#   cp .env.example .env.local
#   然后填入真实值。.env.local 已在 .gitignore 中，不会被提交。
#
# ⚠️ 规则红线：API 密钥等敏感信息不得出现在公开仓库中。
#    提交前请用 `git log -p | grep -iE "sk-|api[_-]?key"` 全量扫描确认。

# ─────────────── 模型服务 ───────────────
# 主力模型：推理、意图路由、记忆提取、反思生成原则
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 多模态模型：解析收据 / 截图 / 文档（可选，未配置则多模态功能降级）
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ─────────────── 运行参数 ───────────────
# 路由置信度阈值：低于此值不猜测，转为询问用户（见方案 § 2.2①）
ROUTING_CONFIDENCE_THRESHOLD=0.6

# 记忆演化参数（见方案 § 8.4）
# 适应度 EMA 平滑系数。越小越"渐变"，越不容易被单次事件影响
FITNESS_EMA_ALPHA=0.15
# 连续未命中多少天后进入休眠
MEMORY_DORMANT_DAYS=60
# 适应度低于此值且长期休眠则归档
MEMORY_ARCHIVE_FITNESS_THRESHOLD=0.25
# 探索性召回比例（防局部最优，见方案 § 8.5）
EXPLORATORY_RECALL_RATIO=0.1

# ─────────────── 成本与安全熔断 ───────────────
# 单会话最大推理轮次
MAX_ROUNDS_PER_SESSION=20
# 全局日额度上限（元）。达到后定时任务自动跳过，保留只读浏览
DAILY_BUDGET_CNY=20
# 单次 SQL / 命令类工具的执行耗时上限（毫秒）
TOOL_TIMEOUT_MS=15000

# ─────────────── 隐私（见方案 § 7.3）───────────────
# 行为观察默认关闭；开启后采集边界写死在代码中，不由此变量放宽
BEHAVIOR_OBSERVATION_ENABLED=false
# 原始活动记录保留天数，到期自动清除，长期仅保留聚合规律
ACTIVITY_RAW_RETENTION_DAYS=7

# ─────────────── 本地存储 ───────────────
# 本地优先：数据默认不出设备。设为 true 时启用 IndexedDB 持久化
LOCAL_FIRST=true
# 导出文件是否包含凭证（默认排除）。设为 true 时必须提供加密口令
EXPORT_INCLUDE_CREDENTIALS=false
